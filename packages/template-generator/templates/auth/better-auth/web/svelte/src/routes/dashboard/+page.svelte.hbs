<script lang="ts">
	import type { PageProps } from './$types';
{{#if (eq payments "polar")}}
	import { authClient } from '#lib/auth-client.ts';
{{else if (and (ne payments "none") (ne payments "polar"))}}
	import PaymentActions from '#lib/components/PaymentActions.svelte';
	import { usePayment } from '#lib/payments.ts';
{{/if}}
	{{#if (eq api "orpc")}}
	import { orpc } from '#lib/orpc.ts';
	import { createQuery } from '@tanstack/svelte-query';
	{{/if}}
	let { data }: PageProps = $props();

{{#if (and (ne payments "none") (ne payments "polar"))}}
	const { state: paymentState, isLoading: paymentLoading, checkout, portal } = usePayment();
{{/if}}

	{{#if (eq api "orpc")}}
	const privateDataQuery = createQuery(() => orpc.privateData.queryOptions());
	{{/if}}
</script>

	<div>
		<h1>Dashboard</h1>
		<p>Welcome {data.user.name}</p>
		{{#if (eq api "orpc")}}
		<p>API: {privateDataQuery.data?.message}</p>
		{{/if}}
		{{#if (eq payments "polar")}}
		<p>Plan: {(data.customerState?.activeSubscriptions?.length ?? 0) > 0 ? "Pro" : "Free"}</p>
		{#if (data.customerState?.activeSubscriptions?.length ?? 0) > 0}
			<button onclick={async () => await authClient.customer.portal()}>
				Manage Subscription
			</button>
		{:else}
			<button onclick={async () => await authClient.checkout({ slug: "pro" })}>
				Upgrade to Pro
			</button>
		{/if}
		{{else if (and (ne payments "none") (ne payments "polar"))}}
		<PaymentActions
			isActive={$paymentState.isActive}
			planLabel={$paymentState.planLabel}
			pending={$paymentLoading}
			onCheckout={checkout}
			onPortal={portal}
		/>
		{{/if}}
	</div>
