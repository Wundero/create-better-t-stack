import { computed, getCurrentScope, onScopeDispose, ref } from "vue";
import { createFormatters } from "@{{projectName}}/i18n/format";
import { i18n, onLocaleChange } from "@{{projectName}}/i18n/runtime";
import type { Locale } from "@{{projectName}}/i18n/config";

/**
 * Vue composable over the shared runtime. Lingui has no Vue binding, so the
 * message descriptors live in `.ts` files (transformed by `@lingui/vite-plugin`)
 * and components call `i18n.t(...)` / `i18n._(...)` with them.
 *
 * `locale` and `formatters` are reactive: switching the locale re-renders any
 * template that reads them.
 */
export function useAppI18n() {
  const locale = ref(i18n.locale) as { value: Locale };

  const unsubscribe = onLocaleChange((next) => {
    locale.value = next;
  });
  if (getCurrentScope()) onScopeDispose(unsubscribe);

  return {
    i18n,
    locale,
    formatters: computed(() => createFormatters(locale.value)),
  };
}
