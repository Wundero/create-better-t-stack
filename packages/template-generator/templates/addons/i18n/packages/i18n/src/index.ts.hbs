{{#if (eq i18n "lingui")}}
import { i18n } from "@lingui/core";
import { messages as enMessages } from "./locales/en";

export function setupI18n(locale = "en") {
  i18n.load("en", enMessages);
  i18n.activate(locale);
  return i18n;
}

export { i18n };
{{else}}
export function setupI18n(_locale = "en") {
  return {};
}
{{/if}}
