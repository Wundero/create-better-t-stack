{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bts-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bts-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "OSS_STATS_KV", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["0 */6 * * *"] },
  "routes": [{ "pattern": "api.create.1d.gg", "custom_domain": true }],
  "observability": { "enabled": true },
}
